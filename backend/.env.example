# 数据库（SQLite 单文件，路径相对 prisma/schema.prisma 所在目录）
DATABASE_URL="file:./dev.db"

# 服务端口
PORT=3000

# JWT —— 部署前改成你自己的随机长字符串
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="15d"

# DeepSeek（仅后端使用，前端永不接触）
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# 本地小模型兜底（OpenAI 兼容端点，如 Ollama / vLLM / LM Studio）。
# 当无法访问 DeepSeek（断网 / 无 key / 上游错误）时，自动改用本地模型继续回答。
# URL 须为 OpenAI 兼容且含 /v1 前缀；留空则不启用兜底。
# Ollama 示例（开发机 RTX3080、部署机 RTX5060 laptop）：先 `ollama pull qwen2.5:3b`
#   LOCAL_AI_URL="http://localhost:11434/v1"
LOCAL_AI_URL=""
LOCAL_AI_MODEL="qwen2.5:3b"
LOCAL_AI_API_KEY=""
