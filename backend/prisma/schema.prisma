// TripGo（文脉粤游）数据模型 —— SQLite 单文件库
// 改表结构后执行：npx prisma migrate dev --name <说明>

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  username    String   @unique
  email       String   @unique
  password    String
  avatar      String?
  points      Int      @default(0)
  balance     Float    @default(200) // 钱包余额（新用户礼包）
  couponCount Int      @default(2) // 可用券数（新用户礼包）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  addresses Address[]
  trips     Trip[]
  orders    Order[]
  stories   Story[]
  comments  Comment[]
  likes        Like[]
  checkins     Checkin[]
  transactions Transaction[]
  favorites    Favorite[]
  reviews      Review[]
}

model Address {
  id        String  @id @default(uuid())
  label     String
  detail    String
  phone     String  @default("")
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

model Trip {
  id        String   @id @default(uuid())
  name      String
  days      Json
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id           Int      @id @default(autoincrement())
  type         String // 普通订单 / 活动预订 / 行程订单
  title        String
  img          String?
  price        Float
  oriPrice     Float
  pointsUsed   Int      @default(0)
  pointsDeduct Int      @default(0)
  finalPrice   Float
  status       String   @default("待支付")
  meta         Json? // 各类订单的附加字段：date / participants / routeName / startDate / endDate / travelers
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  createdAt    DateTime @default(now())
}

model Story {
  id        Int       @id @default(autoincrement())
  title     String
  content   String
  images    Json // string[]
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  comments  Comment[]
  likes     Like[]
  createdAt DateTime  @default(now())
}

model Comment {
  id        Int      @id @default(autoincrement())
  text      String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyId   Int
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  createdAt DateTime @default(now())
}

model Like {
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyId   Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@id([storyId, userId])
}

// 首页轮播图（对应 Legacy index1.html .top_AD）。
model Banner {
  id       Int    @id @default(autoincrement())
  image    String // 图片 key，前端按 key 解析本地资源
  title    String @default("") // 浮层主标题（城市 / 景点名）
  subtitle String @default("") // 浮层副标题（一句话标语）
  sort     Int    @default(0)
}

// 景点（首页人气榜大卡 + 首页瀑布流 + 行程城市 POI 共用）。
model Scenic {
  id      Int     @id @default(autoincrement())
  name    String
  image   String // 图片 key
  city    String  @default("")
  summary String  @default("") // 一句话简介 / 长描述
  tag     String  @default("") // 角标，如「文史口碑馆」
  note    String  @default("") // 附注，如「16 个上榜项」
  hot     Boolean @default(false) // true=人气榜（首页大横卡），仅 section=home 用
  section String  @default("home") // home=首页景点 / poi=行程城市精选
  sort    Int     @default(0)
}

// 首页知识小课堂答题卡（对应 Legacy index1.html .list_4）。
model Quiz {
  id    Int    @id @default(autoincrement())
  tag   String
  title String
  desc  String
  btn   String
  sort  Int    @default(0)
}

// RAG 文化知识库的文本块。
// 注意：向量本身不存在这张表。向量虚拟表（sqlite-vec 的 vec0）由 RAG 模块用
// 原生 SQL 创建，通过 rowid 与本表关联 —— 见 CLAUDE.md 第 7 节。
model KnowledgeChunk {
  id        Int      @id @default(autoincrement())
  source    String // 来源文档标识
  content   String // 文本块内容
  createdAt DateTime @default(now())
}

// 每日签到记录。
model Checkin {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  date      String // YYYY-MM-DD
  points    Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

// 钱包交易流水
model Transaction {
  id        Int      @id @default(autoincrement())
  type      String   @default("out") // in / out
  title     String
  amount    String // "+10" / "-128.00"
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())
}

// 用户收藏（活动/景点/产品）
model Favorite {
  id       Int      @id @default(autoincrement())
  itemType String // scenic / destination / activity
  itemId   Int
  title    String
  date     String  @default("")
  location String  @default("")
  tag      String  @default("")
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  createdAt DateTime @default(now())

  @@unique([userId, itemType, itemId])
}

// 产品/景点评价
model Review {
  id        Int      @id @default(autoincrement())
  itemType  String // destination / scenic
  itemId    Int
  rating    Int      @default(5)
  text      String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  createdAt DateTime @default(now())
}

// 目的地产品（扩展）
model Destination {
  id          Int    @id @default(autoincrement())
  title       String
  image       String
  money       String
  number      String
  type        Int
  description String  @default("") // 产品详情描述
  detail      String  @default("") // 产品规格/参数
}

// 文化内容（粤语短语/课程/学习主题/VR场景）
model CulturalContent {
  id       Int    @id @default(autoincrement())
  category String // phrase / lesson / topic / vr_scene
  title    String
  subtitle String @default("")
  content  String @default("") // JSON: extra fields
  icon     String @default("")
  color    String @default("")
  sort     Int    @default(0)
}
