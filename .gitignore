# 旧项目（只读参考，不纳入新仓库）
/Legacy TripGo ReadOnly!!!/

# 依赖
node_modules/
**/node_modules/

# 构建产物
dist/
build/
**/dist/
*.tsbuildinfo

# 环境变量（.env.example 入库，.env 不入库）
.env
.env.local
**/.env

# SQLite 本地库不入库（演示数据用 seed 脚本生成）
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite

# 运行期生成的上传文件
backend/uploads/

# 本地 TTS 模型 / 二进制（Piper / VITS，数百 MB，运行期资源，不入库；新环境自行放置到 backend/tts/）
backend/tts/

# 本地大模型（llama.cpp 二进制 + GGUF 模型，数 GB，运行期资源；用 scripts/run-local-ai.ps1 自动下载）
backend/local-ai/

# 日志
*.log
npm-debug.log*

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json

# Claude Code 本地预览配置（含本机端口 / 命令，不入库）
/.claude/

# Expo（前端，后续）
.expo/
web-build/
